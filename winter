#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

if [[ -f .env ]]; then set -a; source .env; set +a; fi
export LOCAL_UID="${LOCAL_UID:-$(id -u)}"
export LOCAL_GID="${LOCAL_GID:-$(id -g)}"
COMPOSE=(docker compose -f compose.yaml -f compose.llm.yaml -f compose.gpu.yaml)
MODEL_URL=${WINTER_LLM_URL:-http://127.0.0.1:18080}
ANALYSIS_MODEL_URL=${WINTER_ANALYSIS_LLM_URL:-${WINTER_REFLECTION_LLM_URL:-}}
PYTHON_BIN=${WINTER_PYTHON:-}

find_python() {
  if [[ -n "$PYTHON_BIN" ]]; then
    [[ -x "$PYTHON_BIN" ]] || {
      echo "WINTER_PYTHON이 실행 가능한 파일이 아닙니다: $PYTHON_BIN" >&2
      exit 1
    }
    return
  fi
  if command -v python3.11 >/dev/null 2>&1; then
    PYTHON_BIN=$(command -v python3.11)
  elif command -v pyenv >/dev/null 2>&1 && PYENV_VERSION=3.11.9 pyenv which python >/dev/null 2>&1; then
    PYTHON_BIN=$(PYENV_VERSION=3.11.9 pyenv which python)
  else
    echo "Python 3.11을 찾지 못했습니다. WINTER_PYTHON에 Python 3.11 경로를 지정하세요." >&2
    exit 1
  fi
}

wait_for_llm() {
  find_python
  for _ in $(seq 1 30); do
    if "$PYTHON_BIN" -c "from urllib.request import urlopen; urlopen('${MODEL_URL%/}/health', timeout=2)" >/dev/null 2>&1; then return 0; fi
    sleep 2
  done
  echo "Orin LLM did not become ready within 60 seconds: $MODEL_URL" >&2
  echo "scripts/orin-tunnel.sh 또는 터널 서비스를 확인하세요." >&2
  return 1
}

run_chat() {
  local needs_llm=1
  local needs_analysis_llm=0
  for argument in "$@"; do
    case "$argument" in
      --review-outcomes|--outcome-audit|--review-memory-candidates|--companion-overview|--list-current-state-history|--lived-continuity|--list-belief-reflection|--list-winter-days)
        needs_llm=0
        ;;
      --analyze-pending-turns|--analyze-pending-outcomes|--reflect-history|--analyze-belief-reflection)
        needs_analysis_llm=1
        ;;
    esac
  done
  if [[ "$needs_analysis_llm" -eq 1 ]]; then
    if [[ -z "$ANALYSIS_MODEL_URL" ]]; then
      echo "사후 분석용 local LLM이 설정되지 않았습니다." >&2
      echo "Orin은 분석 부하에서 재부팅된 기록이 있어 대화용 주소를 자동 재사용하지 않습니다." >&2
      echo "안전한 별도 서버를 WINTER_ANALYSIS_LLM_URL로 지정하세요." >&2
      exit 2
    fi
    MODEL_URL="$ANALYSIS_MODEL_URL"
  fi
  if [[ "$needs_llm" -eq 1 ]]; then
    wait_for_llm
  else
    find_python
  fi
  exec env \
    PYTHONPATH="$ROOT_DIR/src" \
    WINTER_DATA_DIR="$ROOT_DIR/data" \
    WINTER_LLM_URL="$MODEL_URL" \
    "$PYTHON_BIN" -m companion.user_cli --model-url "$MODEL_URL" "$@"
}

run_text_container() {
  # Text defaults to the measured Host Docker profile, not the disabled Orin server.
  MODEL_URL=${WINTER_LLM_URL:-http://127.0.0.1:18081}
  local text_data=${WINTER_TEXT_DATA_DIR:-$ROOT_DIR/data}
  [[ "$text_data" == /* ]] || text_data="$ROOT_DIR/$text_data"
  for argument in "$@"; do
    case "$argument" in
      --codex-worker|--winter-work-canary|--backend|--backend=*)
        echo "text는 실제 로컬 모델을 사용합니다. 대화 중 Codex 요청은 건별 승인을 받습니다. 별도 Worker/backend 스위치는 사용하지 마세요." >&2
        exit 2
        ;;
    esac
  done
  local image=${WINTER_TEXT_IMAGE:-winter-ai:dev}
  if ! docker image inspect "$image" >/dev/null 2>&1; then
    echo "텍스트 실행 이미지가 없습니다: $image (docker compose build dev)" >&2
    exit 1
  fi
  local needs_model=1
  for argument in "$@"; do
    case "$argument" in
      --help|-h|--show-history|--list-*|--companion-overview|--review-*|--outcome-audit|--lived-continuity)
        needs_model=0 ;;
    esac
  done
  if [[ "$needs_model" -eq 1 ]]; then
    if [[ "${MODEL_URL%/}" == "http://127.0.0.1:18081" ]]; then
      bash "$ROOT_DIR/scripts/text-llm.sh" start
    elif ! curl -fsS --max-time 2 "${MODEL_URL%/}/health" >/dev/null 2>&1; then
      echo "지정한 로컬 모델이 준비되지 않았습니다: $MODEL_URL. 다른 모델/Orin으로 자동 전환하지 않습니다." >&2
      exit 1
    fi
  fi
  local supervised=1
  for argument in "$@"; do
    case "$argument" in
      --prompt|--prompt=*|--help|-h|--show-history|--list-*|--companion-overview|--review-*|--outcome-audit|--lived-continuity|--analyze-*|--reflect-history|--close-winter-day|--resolve-open-loop|--dismiss-open-loop)
        supervised=0 ;;
    esac
  done
  local interactive=(-i)
  local module=companion.user_cli
  local prefix=()
  local container_args=()
  if [[ "$supervised" -eq 1 ]]; then
    find_python
    local container_name="winter-text-session-$("$PYTHON_BIN" -c 'import uuid; print(uuid.uuid4().hex)')"
    module=companion.text_child
    container_args=(--name "$container_name")
    prefix=(env PYTHONPATH="$ROOT_DIR/src" "$PYTHON_BIN" -m companion.text_host
      --project-root "$ROOT_DIR" --container-name "$container_name"
      --audit-dir "$text_data/worker_sessions"
      --data-dir "$text_data"
      --codex-executable "${WINTER_CODEX_BIN:-codex}"
      --codex-model "${WINTER_CODEX_MODEL:-gpt-5.6-sol}" --)
  elif [[ -t 0 && -t 1 ]]; then
    interactive+=(-t)
  fi
  # Host networking reaches the loopback inference server.
  # Explicit workers/authentication are deliberately not forwarded to this container.
  exec "${prefix[@]}" docker run --rm "${container_args[@]}" "${interactive[@]}" --network host --read-only \
    --user "$LOCAL_UID:$LOCAL_GID" --cap-drop ALL --security-opt no-new-privileges \
    --pids-limit 128 --memory 1g --tmpfs /tmp:rw,nosuid,nodev,size=64m \
    --log-opt max-size=5m --log-opt max-file=2 \
    -e PYTHONDONTWRITEBYTECODE=1 -e PYTHONPATH=/workspace/src:/workspace \
    -e WINTER_DATA_DIR=/workspace/data -e WINTER_LLM_URL="$MODEL_URL" \
    -v "$ROOT_DIR/src:/workspace/src:ro" \
    -v "$ROOT_DIR/configs:/workspace/configs:ro" \
    -v "$text_data:/workspace/data:rw" -w /workspace \
    "$image" python -m "$module" --model-url "$MODEL_URL" \
    --dialogue-policy companion "$@"
}

case "${1:-start}" in
  text)
    shift
    run_text_container "$@"
    ;;
  start)
    shift || true
    run_chat "$@"
    ;;
  chat)
    shift
    run_chat "$@"
    ;;
  voice)
    shift
    wait_for_llm
    exec env \
      PYTHONPATH="$ROOT_DIR/src" \
      WINTER_DATA_DIR="$ROOT_DIR/data" \
      WINTER_LLM_URL="$MODEL_URL" \
      "$PYTHON_BIN" -m companion.voice_cli --model-url "$MODEL_URL" "$@"
    ;;
  reflect)
    shift
    run_chat --reflect-history "$@"
    ;;
  memories)
    shift
    run_chat --review-memory-candidates "$@"
    ;;
  overview)
    shift
    run_chat --companion-overview "$@"
    ;;
  state)
    shift
    run_chat --list-current-state-history "$@"
    ;;
  lived)
    shift
    run_chat --lived-continuity "$@"
    ;;
  viewpoints)
    shift
    run_chat --list-belief-reflection "$@"
    ;;
  viewpoint-shadow)
    shift
    run_chat --analyze-belief-reflection "$@"
    ;;
  days)
    shift
    run_chat --list-winter-days "$@"
    ;;
  capabilities)
    shift
    find_python
    exec env \
      PYTHONPATH="$ROOT_DIR/src" \
      WINTER_DATA_DIR="$ROOT_DIR/data" \
      "$PYTHON_BIN" -m companion.capability_admin --list "$@"
    ;;
  improvements)
    shift
    find_python
    exec env \
      PYTHONPATH="$ROOT_DIR/src" \
      WINTER_DATA_DIR="$ROOT_DIR/data" \
      "$PYTHON_BIN" -m companion.improvement_admin "$@"
    ;;
  day-close)
    shift
    run_chat --close-winter-day "$@"
    ;;
  project-check)
    shift
    find_python
    exec env \
      PYTHONPATH="$ROOT_DIR/src" \
      "$PYTHON_BIN" -m companion.project_control \
      --root "$ROOT_DIR" \
      --state "$ROOT_DIR/project-state.toml" \
      "$@"
    ;;
  status)
    bash "$ROOT_DIR/scripts/text-llm.sh" status
    if [[ -n "${WINTER_LLM_URL:-}" && "${WINTER_LLM_URL%/}" != "http://127.0.0.1:18081" ]]; then
      echo "text의 명시적 주소 설정: $WINTER_LLM_URL (자동 시작/종료 대상 아님)"
    fi
    "${COMPOSE[@]}" ps
    ;;
  stop)
    bash "$ROOT_DIR/scripts/text-llm.sh" stop
    "${COMPOSE[@]}" stop llm
    ;;
  *)
    echo "Usage: ./winter {text|start|chat|voice|reflect|memories|overview|state|lived|days|day-close|viewpoints|viewpoint-shadow|capabilities|improvements|project-check|status|stop}" >&2
    exit 2
    ;;
esac
