#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

if [[ -f .env ]]; then set -a; source .env; set +a; fi
export LOCAL_UID="${LOCAL_UID:-$(id -u)}"
export LOCAL_GID="${LOCAL_GID:-$(id -g)}"
COMPOSE=(docker compose -f compose.yaml -f compose.llm.yaml -f compose.gpu.yaml)

require_model_config() {
  for name in LLAMA_RUNTIME_DIR LLM_MODEL_DIR LLM_MODEL_FILE; do
    [[ -n "${!name:-}" ]] || { echo "Missing $name. Copy .env.example to .env and set local model paths."; exit 1; }
  done
}

wait_for_llm() {
  for _ in $(seq 1 30); do
    if "${COMPOSE[@]}" run --rm dev python -c "from urllib.request import urlopen; urlopen('http://llm:8080/health', timeout=2)" >/dev/null 2>&1; then return 0; fi
    sleep 2
  done
  echo "Local LLM did not become ready within 60 seconds. Run ./winter status for details." >&2
  return 1
}

case "${1:-start}" in
  start)
    require_model_config
    "${COMPOSE[@]}" up -d llm
    wait_for_llm
    exec "${COMPOSE[@]}" run --rm dev python -m companion.user_cli
    ;;
  chat)
    require_model_config
    wait_for_llm
    exec "${COMPOSE[@]}" run --rm dev python -m companion.user_cli
    ;;
  status)
    require_model_config
    "${COMPOSE[@]}" ps
    ;;
  stop)
    "${COMPOSE[@]}" stop llm
    ;;
  *)
    echo "Usage: ./winter {start|chat|status|stop}" >&2
    exit 2
    ;;
esac
