#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

if [[ -f .env ]]; then set -a; source .env; set +a; fi
export LOCAL_UID="${LOCAL_UID:-$(id -u)}"
export LOCAL_GID="${LOCAL_GID:-$(id -g)}"
COMPOSE=(docker compose -f compose.yaml -f compose.llm.yaml -f compose.gpu.yaml)
# The voice path additionally publishes the model server on Host loopback,
# because its CLI runs on the Host rather than in the dev container.
VOICE_COMPOSE=("${COMPOSE[@]}" -f compose.llm-host.yaml)

require_model_config() {
  for name in LLAMA_RUNTIME_DIR LLM_MODEL_DIR LLM_MODEL_FILE; do
    [[ -n "${!name:-}" ]] || { echo "Missing $name. Copy .env.example to .env and set local model paths."; exit 1; }
  done
}

wait_for_llm() {
  for _ in $(seq 1 30); do
    if "${COMPOSE[@]}" run --rm dev python -c "from urllib.request import urlopen; urlopen('http://llm:8080/health', timeout=2)" >/dev/null 2>&1; then return 0; fi
    sleep 2
  done
  echo "Local LLM did not become ready within 60 seconds. Run ./winter status for details." >&2
  return 1
}

case "${1:-start}" in
  start)
    require_model_config
    "${COMPOSE[@]}" up -d llm
    wait_for_llm
    exec "${COMPOSE[@]}" run --rm dev python -m companion.user_cli
    ;;
  chat)
    require_model_config
    wait_for_llm
    exec "${COMPOSE[@]}" run --rm dev python -m companion.user_cli
    ;;
  voice)
    require_model_config
    shift
    "${VOICE_COMPOSE[@]}" up -d llm
    # Polled from the Host, not through `run --rm dev`: this is the address the
    # voice CLI will actually use, so probing anything else can pass while the
    # real path is still broken.
    for _ in $(seq 1 30); do
      if python3 -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:8080/health', timeout=2)" >/dev/null 2>&1; then break; fi
      sleep 2
    done
    exec env PYTHONPATH="$ROOT_DIR/src" python3 -m companion.voice_cli "$@"
    ;;
  status)
    require_model_config
    "${COMPOSE[@]}" ps
    ;;
  stop)
    "${COMPOSE[@]}" stop llm
    ;;
  *)
    echo "Usage: ./winter {start|chat|voice|status|stop}" >&2
    exit 2
    ;;
esac
