# Few-shot Korean voice cloning, pinned.
#
# MeloTTS gives one fixed Korean speaker and cannot clone. This image is the
# first thing in the project that can say a sentence in a *chosen* voice, from a
# few seconds of reference audio and no training at all.
#
# CPU-only on purpose. The development host's GPU is a 6 GiB RTX 2060 that the
# local LLM already occupies, and this stage only has to answer one question —
# does the voice resemble the Reference — which a slow synthesis answers just as
# well as a fast one. Training (S3) is where the GPU becomes worth the fight.

FROM python:3.10-slim-bookworm

ARG GPT_SOVITS_REF=d523079fc05d9a8028d6085bffe4a2757c32abb6
# v2 rather than v3/v4: it is the generation whose released weights cover
# Korean, and its checkpoints are the ones the repository documents for
# multilingual zero-shot.
ARG WEIGHTS_DIR=gsv-v2final-pretrained

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        build-essential git curl ffmpeg libsndfile1 cmake \
    && rm -rf /var/lib/apt/lists/*

# The image's own pip rejects the PyTorch index: it reads the name in
# typing_extensions' metadata as different from the one it asked for and gives
# up. Normalisation was fixed upstream, so this is a version floor, not taste.
RUN pip install --no-cache-dir --upgrade pip==25.2

# Torch first and explicitly, so the transitive requirements below cannot pull a
# CUDA build. A matching torch/torchaudio pair is a hard requirement; the
# diarization image was broken twice by letting them resolve independently.
#
# 2.7.1 rather than something older: x_transformers now pulls
# torch-einops-utils, which requires torch>=2.5. Pinning 2.4.1 sent pip
# backtracking through x_transformers releases one download at a time and the
# build never finished. Well inside the range the repository tests (2.2.2-2.8).
RUN pip install --no-cache-dir \
        torch==2.7.1+cpu torchaudio==2.7.1+cpu \
        --index-url https://download.pytorch.org/whl/cpu

RUN git clone --depth 1 --branch main https://github.com/RVC-Boss/GPT-SoVITS.git /opt/gpt-sovits \
    && git -C /opt/gpt-sovits fetch --depth 1 origin "$GPT_SOVITS_REF" \
    && git -C /opt/gpt-sovits checkout "$GPT_SOVITS_REF" \
    && test "$(git -C /opt/gpt-sovits rev-parse HEAD)" = "$GPT_SOVITS_REF"

# Weights are baked in rather than mounted: the probe must run with no network,
# and a mounted cache made the MeloTTS image fail in ways that looked like
# synthesis bugs. ~2 GiB.
#
# Downloaded *before* the dependency install, and with its own small pinned
# client, so that editing the lock does not re-fetch 2 GiB. The lock changed
# five times while this image was being brought up; putting the expensive stable
# layer above the volatile one turns each of those retries from minutes into
# seconds.
RUN pip install --no-cache-dir huggingface_hub==0.26.5

COPY experiments/gpt_sovits_fetch_models.py /opt/probe/gpt_sovits_fetch_models.py
RUN python /opt/probe/gpt_sovits_fetch_models.py \
        --destination /opt/gpt-sovits/GPT_SoVITS/pretrained_models \
        --weights-dir "$WEIGHTS_DIR"

# The lock is a constraint on this resolution, not a second install pass. Applied
# afterwards it arrives too late to stop pip exploring versions the pins would
# have excluded, which is how the first build stalled.
COPY requirements/gpt-sovits.lock /tmp/gpt-sovits.lock
RUN pip install --no-cache-dir -c /tmp/gpt-sovits.lock -r /opt/gpt-sovits/requirements.txt \
    && pip install --no-cache-dir -r /tmp/gpt-sovits.lock

# The Korean grapheme-to-phoneme path downloads a dictionary on first use.
# Doing it at build time keeps the run offline.
RUN python -c "import g2pk2; g2pk2.G2p()" || true

# Every cache the stack writes to, sent somewhere a non-root user can write.
# Set on the image rather than on each `docker run` because forgetting one is
# not a missing-cache warning — numba refuses to start and the traceback points
# at librosa, which reads as a synthesis bug. The MeloTTS image failed the same
# way; the fix belongs next to the software that needs it.
#
# Offline is asserted, not assumed: the weights are baked in, so a lookup
# reaching for the network means something is missing locally and should fail
# loudly. The import check below runs under these too, so it tests that.
ENV HOME=/tmp \
    NUMBA_CACHE_DIR=/tmp/numba \
    MPLCONFIGDIR=/tmp/matplotlib \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

# Fail the build rather than a run: importing the inference module is where a
# mismatched dependency shows up, and it is 2 GiB of weights too late to notice
# at synthesis time.
RUN cd /opt/gpt-sovits && python -c "\
import sys; sys.path.append('GPT_SoVITS');\
from GPT_SoVITS.inference_webui import get_tts_wav, change_gpt_weights, change_sovits_weights;\
print('inference import OK')"

# The module records the loaded checkpoint to ./weight.json as it imports, and
# the working directory belongs to root. Running as the Host user — so output
# files are not root-owned — then fails before any synthesis starts.
#
# The working directory cannot simply move somewhere writable: the module finds
# its own checkpoints through relative paths, so it has to run from here.
RUN touch /opt/gpt-sovits/weight.json \
    && chmod 666 /opt/gpt-sovits/weight.json \
    && mkdir -p /opt/gpt-sovits/TEMP \
    && chmod 777 /opt/gpt-sovits /opt/gpt-sovits/TEMP

COPY experiments/gpt_sovits_runner.py /opt/probe/gpt_sovits_runner.py

WORKDIR /opt/gpt-sovits
ENTRYPOINT ["python", "/opt/probe/gpt_sovits_runner.py"]
