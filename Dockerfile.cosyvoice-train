# CosyVoice fine-tuning, on the one GPU this project has.
#
# Separate from Dockerfile.cosyvoice because that one is deliberately CPU-only:
# synthesis runs fine on a CPU and the 6 GiB card is wanted for the local LLM.
# Training is the opposite — it cannot happen on a CPU at this size — so this
# image carries the CUDA runtime and nothing else changes.
#
# Whether it fits is an open question, written here so the arithmetic is not
# rediscovered later. flow.pt is 1.33 GiB, so around 330 M parameters:
#
#   weights (fp32)      1.33 GiB
#   gradients           1.33 GiB
#   Adam moments (x2)   2.66 GiB
#   ------------------  --------
#   before activations  5.32 GiB   on a 6 GiB card
#
# So the default recipe will not fit, and the run script reaches for a smaller
# optimizer state and a batch of one before it reaches for anything clever. If
# it still does not fit, that is a hardware answer rather than a tuning answer.
#
# cu121 matches the host's driver (535.230.02, CUDA 12.2). Torch is pinned to
# the version the repository pins, in its CUDA build rather than its CPU one.

FROM python:3.10-slim-bookworm

ARG COSYVOICE_REF=074ca6dc9e80a2f424f1f74b48bdd7d3fea531cc

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        build-essential git curl ffmpeg libsndfile1 sox libsox-dev unzip \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip==25.2

RUN pip install --no-cache-dir \
        torch==2.3.1 torchaudio==2.3.1 \
        --index-url https://download.pytorch.org/whl/cu121

RUN git clone --recursive https://github.com/QwenAudio/CosyVoice.git /opt/cosyvoice \
    && git -C /opt/cosyvoice fetch --depth 1 origin "$COSYVOICE_REF" \
    && git -C /opt/cosyvoice checkout "$COSYVOICE_REF" \
    && git -C /opt/cosyvoice submodule update --init --recursive \
    && test "$(git -C /opt/cosyvoice rev-parse HEAD)" = "$COSYVOICE_REF"

# Weights above the dependency layer, so editing anything below does not refetch
# gigabytes.
RUN pip install --no-cache-dir huggingface_hub==0.26.5
COPY experiments/cosyvoice_fetch_models.py /opt/probe/cosyvoice_fetch_models.py
RUN python /opt/probe/cosyvoice_fetch_models.py \
        --destination /opt/cosyvoice/pretrained_models/CosyVoice3-0.5B

# Fewer removals than the CPU image. deepspeed stays: train.py imports it at
# module scope whether or not it is the chosen engine, so stripping it makes the
# script unimportable. tensorrt is a serving runtime and the web stack's pins
# disagree with each other over typer, so those still go.
#
# bitsandbytes is added for its 8-bit optimizer — the difference between 2.66
# GiB of Adam state and about 0.66 GiB, which is what a 6 GiB card turns on.
# pandas is needed by the parquet step and is not in the repository's list.
RUN printf 'setuptools<81\n' > /tmp/build-constraints.txt \
    && grep -vE '^(tensorrt-cu12|torch==|torchaudio==|--extra-index-url|gradio|fastapi|uvicorn|grpcio)' \
        /opt/cosyvoice/requirements.txt > /tmp/requirements-train.txt \
    && PIP_CONSTRAINT=/tmp/build-constraints.txt \
       pip install --no-cache-dir -r /tmp/requirements-train.txt \
    && pip install --no-cache-dir bitsandbytes==0.44.1 "pandas<3" \
    && true

# CosyVoice's training script imports deepspeed unconditionally, and deepspeed
# runs `$CUDA_HOME/bin/nvcc -V` while it *imports* — not while it builds
# anything — to read a version number. Without one, nothing loads at all.
#
# Nothing in this image compiles a CUDA kernel: training runs on plain torch,
# and the pip CUDA packages ship ptxas without nvcc while Debian's toolkit is
# 2 GiB from a repository this image does not enable. So the version answer is
# given directly, from the CUDA that torch was actually built against.
#
# Any other invocation fails loudly. A stub that pretended to compile would
# produce a broken object and a confusing error somewhere far away.
RUN mkdir -p /opt/cuda-stub/bin \
    && printf '%s\n' \
        '#!/bin/sh' \
        '# Reports the CUDA version torch was built with. Compiles nothing.' \
        'case "$1" in' \
        '  -V|--version)' \
        '    CUDA_VERSION=$(python -c "import torch; print(torch.version.cuda)")' \
        '    echo "nvcc: NVIDIA (R) Cuda compiler driver"' \
        '    echo "Cuda compilation tools, release ${CUDA_VERSION}, V${CUDA_VERSION}.0"' \
        '    ;;' \
        '  *)' \
        '    echo "nvcc stub: this image does not compile CUDA. Called with: $*" >&2' \
        '    exit 127' \
        '    ;;' \
        'esac' \
        > /opt/cuda-stub/bin/nvcc \
    && chmod 755 /opt/cuda-stub/bin/nvcc

# The wetext frontend is fetched from ModelScope on first use, and HOME is /tmp,
# so every fresh container downloaded it again — 292 seconds before the server
# would answer. Baked into the image and pointed at from a path that survives
# the container instead.
ENV MODELSCOPE_CACHE=/opt/modelscope

ENV HOME=/tmp \
    NUMBA_CACHE_DIR=/tmp/numba \
    MPLCONFIGDIR=/tmp/matplotlib \
    TRITON_CACHE_DIR=/tmp/triton \
    CUDA_HOME=/opt/cuda-stub \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PYTHONPATH=/opt/cosyvoice:/opt/cosyvoice/third_party/Matcha-TTS

# Imports only, not a model load: this image runs where a GPU is attached, and
# a build host may not have one.
RUN cd /opt/cosyvoice && python -c "\
import torch, bitsandbytes;\
from cosyvoice.bin.train import main;\
print('train import OK, torch', torch.__version__)"

# Verified rather than assumed: a download step that quietly does nothing looks
# exactly like one that worked, and this project has already lost five builds
# that way.
# revision='master' on purpose: without it ModelScope resolves the revision
# first, and that call wants a token this build does not have. It is also the
# path the runtime takes, so this bakes what would otherwise be downloaded.
RUN python -c "\
from modelscope import snapshot_download;\
print(snapshot_download('pengzhendong/wetext', revision='master'))" \
    && test -d /opt/modelscope/hub/pengzhendong/wetext \
    && chmod -R a+rX /opt/modelscope

RUN mkdir -p /tmp/numba /tmp/matplotlib /tmp/triton \
    && chmod -R 777 /tmp/numba /tmp/matplotlib /tmp/triton \
    && chmod -R a+w /opt/cosyvoice/pretrained_models/CosyVoice3-0.5B \
    && chmod 777 /opt/cosyvoice

WORKDIR /opt/cosyvoice
