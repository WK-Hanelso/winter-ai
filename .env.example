# Required only with compose.voice.yaml.
# Typical Host value: /run/user/1000/pulse/native
PULSE_SOCKET_PATH=/run/user/1000/pulse/native

# Text chat uses the private Orin SSH tunnel by default. Override only when
# intentionally testing a different local llama-server.
WINTER_LLM_URL=http://127.0.0.1:18080
# 기억 이력 정리는 대화용 Orin을 자동 재사용하지 않습니다. 안전한 별도 local
# llama-server를 준비한 경우에만 아래 값을 설정하세요.
# WINTER_ANALYSIS_LLM_URL=http://127.0.0.1:18081
# Optional when python3.11 is already on PATH.
# WINTER_PYTHON=/path/to/python3.11

# Required only when launching the legacy local llama-server Compose service.
# Host-only paths; do not commit .env.
LLAMA_RUNTIME_DIR=/path/to/llama-b10276-parent
LLM_MODEL_DIR=/path/to/gguf-directory
LLM_MODEL_FILE=Qwen3-4B-Instruct-2507.Q4_K_M.gguf
