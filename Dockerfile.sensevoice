FROM ubuntu:24.04

RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends libgomp1 libstdc++6 python3 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY src/companion/sensevoice_server.py /app/sensevoice_server.py

ENTRYPOINT ["python3", "/app/sensevoice_server.py"]
